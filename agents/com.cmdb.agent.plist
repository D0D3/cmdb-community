<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon macOS — exécute l'agent CMDB tous les jours à 07h00
  Installation :
    sudo cp com.cmdb.agent.plist /Library/LaunchDaemons/
    sudo launchctl load -w /Library/LaunchDaemons/com.cmdb.agent.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cmdb.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>source /etc/cmdb-agent.conf &amp;&amp; /usr/local/bin/cmdb-agent</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>   <integer>7</integer>
        <key>Minute</key> <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/var/log/cmdb-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/cmdb-agent.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
