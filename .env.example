# Domaine public
DOMAIN=cmdb.example.com

# Base de données (PostgreSQL par défaut — changer le driver pour MySQL/MariaDB/MSSQL)
# PostgreSQL : postgresql+psycopg://user:pass@db/cmdb
# MySQL      : mysql+pymysql://user:pass@db/cmdb
# MariaDB    : mariadb+pymysql://user:pass@db/cmdb
# MSSQL      : mssql+pyodbc://user:pass@db/cmdb?driver=ODBC+Driver+18+for+SQL+Server
# Mots de passe — générer avec : openssl rand -hex 32
DATABASE_URL=postgresql+psycopg://cmdb:POSTGRES_PASSWORD@db/cmdb
POSTGRES_DB=cmdb
POSTGRES_USER=cmdb
POSTGRES_PASSWORD=

# Redis
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=

# Sécurité application — générer avec : openssl rand -base64 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Compte admin local (break-glass)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Environnement (dev / staging / prod)
ENVIRONMENT=prod

# LDAP (optionnel — laisser vide pour désactiver)
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_BASE_DN=
LDAP_TLS=true

# OIDC (optionnel — laisser vide pour désactiver)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# SMTP (optionnel — Should Have)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cmdb@example.com
